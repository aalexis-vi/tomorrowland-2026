      </a>

      <nav class="main-nav" id="mainNav" aria-label="Navegación principal">
        <ul class="nav-list">
          <li class="nav-item"><a href="#inicio" class="nav-link">Inicio</a></li>

          <li class="nav-item has-dropdown">
            <button class="nav-link nav-toggle" aria-expanded="false">Festival <span class="caret" aria-hidden="true"></span></button>
            <div class="dropdown">
              <a href="#belgica" class="dropdown-link">Tomorrowland Bélgica</a>
              <a href="#brasil" class="dropdown-link">Tomorrowland Brasil</a>
              <a href="#radio" class="dropdown-link">Estación de Radio</a>
            </div>
          </li>

          <li class="nav-item has-dropdown">
            <button class="nav-link nav-toggle" aria-expanded="false">Eventos <span class="caret" aria-hidden="true"></span></button>
            <div class="dropdown">
              <a href="#belgica" class="dropdown-link">Bélgica 2026</a>
              <a href="#brasil" class="dropdown-link">Brasil 2027</a>
            </div>
          </li>

          <li class="nav-item has-dropdown">
            <button class="nav-link nav-toggle" aria-expanded="false">Música <span class="caret" aria-hidden="true"></span></button>
            <div class="dropdown">
              <a href="#video" class="dropdown-link">Sets y videos</a>
              <a href="#radio" class="dropdown-link">Estación de Radio</a>
            </div>
          </li>

          <li class="nav-item has-dropdown">
            <button class="nav-link nav-toggle" aria-expanded="false">Tienda <span class="caret" aria-hidden="true"></span></button>
            <div class="dropdown">
              <a href="#" class="dropdown-link">Merchandise</a>
              <a href="#" class="dropdown-link">Entradas</a>
            </div>
          </li>
        </ul>
      </nav>

      <!-- Menú hamburguesa (móvil) -->
      <button class="hamburger" id="hamburgerBtn" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobileMenu">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>

    <!-- Menú móvil desplegable -->
    <div class="mobile-menu" id="mobileMenu">
      <ul class="mobile-nav-list">
        <li><a href="#inicio" class="mobile-link">Inicio</a></li>
        <li class="mobile-accordion">
          <button class="mobile-accordion-toggle">Festival</button>
          <div class="mobile-accordion-panel">
            <a href="#belgica" class="mobile-sublink">Tomorrowland Bélgica</a>
            <a href="#brasil" class="mobile-sublink">Tomorrowland Brasil</a>
            <a href="#radio" class="mobile-sublink">Estación de Radio</a>
          </div>
        </li>
        <li class="mobile-accordion">
          <button class="mobile-accordion-toggle">Eventos</button>
          <div class="mobile-accordion-panel">
            <a href="#belgica" class="mobile-sublink">Bélgica 2026</a>
            <a href="#brasil" class="mobile-sublink">Brasil 2027</a>
          </div>
        </li>
        <li class="mobile-accordion">
          <button class="mobile-accordion-toggle">Música</button>
          <div class="mobile-accordion-panel">
            <a href="#video" class="mobile-sublink">Sets y videos</a>
