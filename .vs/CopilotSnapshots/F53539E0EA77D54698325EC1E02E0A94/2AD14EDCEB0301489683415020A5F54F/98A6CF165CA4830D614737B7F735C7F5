        <li class="mobile-accordion">
          <button class="mobile-accordion-toggle">Tienda</button>
          <div class="mobile-accordion-panel">
            <a href="#" class="mobile-sublink">Merchandise</a>
            <a href="#" class="mobile-sublink">Entradas</a>
          </div>
        </li>
      </ul>
    </div>
  </header>

  <main id="inicio">

    <!-- ============================================================
         HERO / CARRUSEL PRINCIPAL
         ============================================================ -->
    <section class="hero" id="hero" aria-label="Presentación Tomorrowland 2026">
      <div class="hero-track" id="heroTrack">
        <!-- Las diapositivas se generan dinámicamente desde js/carousel.js -->
        <!-- ===== EDITAR IMÁGENES DEL HERO en js/carousel.js (heroSlides) ===== -->
      </div>

      <div class="hero-overlay" aria-hidden="true"></div>

      <div class="hero-content">
        <span class="hero-logo" aria-hidden="true"></span>
        <p class="hero-eyebrow">25 · 26 · 27 JULIO 2026 · BOOM, BÉLGICA</p>
        <h1 class="hero-title">Tomorrowland <span>2026</span></h1>
        <p class="hero-subtitle">A New Reality</p>
      </div>

      <button class="hero-arrow hero-arrow-prev" id="heroPrev" aria-label="Imagen anterior">‹</button>
      <button class="hero-arrow hero-arrow-next" id="heroNext" aria-label="Imagen siguiente">›</button>

      <div class="hero-dots" id="heroDots" role="tablist" aria-label="Selecciona una imagen"></div>

      <a href="#belgica" class="scroll-cue" aria-label="Desplázate hacia abajo">
        <div id="scrollCueLottie" class="scroll-cue-lottie" aria-hidden="true"></div>
      </a>
    </section>

    <!-- ============================================================
         SECCIÓN — VISITAR TOMORROWLAND BÉLGICA
         ============================================================ -->
    <section class="section section-belgium js-blur-on-scroll" id="belgica">
      <div class="section-inner">
        <div class="section-heading reveal">
          <span class="section-eyebrow">Bélgica · Boom</span>
          <h2 class="section-title">Visitar Tomorrowland Bélgica</h2>
        </div>

        <div class="card-carousel" id="belgiumCarousel" aria-label="Noticias de Tomorrowland Bélgica">
          <div class="card-track" id="belgiumTrack">
            <!-- ===== NOTICIAS TOMORROWLAND BÉLGICA ===== -->
            <!-- Tarjetas generadas dinámicamente desde js/main.js (belgiumNews) -->
          </div>

          <div class="card-carousel-controls">
            <button class="card-arrow card-arrow-prev" data-target="belgiumTrack" aria-label="Anterior">‹</button>
            <button class="card-arrow card-arrow-next" data-target="belgiumTrack" aria-label="Siguiente">›</button>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         SECCIÓN DE VIDEO
         ============================================================ -->
    <section class="section section-video js-blur-on-scroll" id="video">
      <div class="section-inner video-layout">
        <div class="video-frame reveal">
          <div class="video-frame-glow js-parallax" data-speed="0.12" aria-hidden="true"></div>
          <div class="video-responsive" id="videoFacade" data-video-id="k5yQBhDnrvM">
            <!-- ===== EDITAR VIDEO (ID de YouTube y miniatura) ===== -->
            <img class="video-poster" src="assets/images/general/video-poster.jpg" alt="Miniatura del video oficial de Tomorrowland" loading="lazy">
            <button class="video-play-btn animate__animated animate__pulse animate__infinite animate__slower" id="videoPlayBtn" aria-label="Reproducir video">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
            </button>
          </div>
        </div>

        <div class="video-text reveal">
          <span class="section-eyebrow">Los recuerdos</span>
          <p class="video-quote">Revive la magia de Tomorrowland Bélgica 2026 y guarda los recuerdos para siempre en tu corazón.</p>
          <a class="video-fallback-link" href="https://www.youtube.com/watch?v=k5yQBhDnrvM" target="_blank" rel="noopener">
            ¿No se reproduce aquí? Míralo en YouTube ↗
          </a>
        </div>
      </div>
    </section>

    <!-- ============================================================
         SECCIÓN — TOMORROWLAND BRASIL 2027
         ============================================================ -->
    <section class="section section-brazil js-blur-on-scroll" id="brasil">
      <div class="section-inner">
        <div class="section-heading reveal">
          <span class="section-eyebrow">Brasil · Itu, São Paulo</span>
          <h2 class="section-title">Tomorrowland Brasil 2027</h2>
        </div>

        <div class="grid-cards" id="brazilGrid">
          <!-- ===== NOTICIAS TOMORROWLAND BRASIL ===== -->
          <!-- Tarjetas de EJEMPLO generadas desde js/main.js (brazilNews). Reemplazar cuando exista contenido oficial. -->
        </div>
      </div>
    </section>

    <!-- ============================================================
         SECCIÓN — ESTACIÓN DE RADIO
         ============================================================ -->
    <section class="section section-radio" id="radio">
      <div class="section-inner">
        <div class="section-heading reveal">
          <span class="section-eyebrow"><span class="live-dot animate__animated animate__flash animate__infinite animate__slower" aria-hidden="true"></span>On air · 24/7</span>
          <h2 class="section-title">Estación de Radio</h2>
        </div>

        <div class="grid-cards grid-cards--radio" id="radioGrid">
          <!-- ===== ESTACIÓN DE RADIO ===== -->
          <!-- Placeholders generados desde js/main.js (radioNews). Reemplazar por contenido real. -->
        </div>
      </div>
    </section>

  </main>

